# Inner Sanctuary Local Preview & Netlify Functions Environment Variables
# Copy this file to ".env" (gitignored) for local testing with preview-server.js,
# and set GEMINI_API_KEY in Netlify -> Site configuration -> Environment variables for live deploys.

GEMINI_API_KEY=your_gemini_api_key_here
# Optional overrides:
# GEMINI_ECHO_MODEL=gemini-4-hydrogen
# GEMINI_ECHO_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_ECHO_VOICE=Vega
